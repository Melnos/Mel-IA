# MEL-IA - Configuration d'environnement Cloud & Local
# Clé API Google Gemini principale du serveur (API débitrice pour mode Invité et Standard)
# Obtenez votre clé gratuite sur : https://aistudio.google.com/
GEMINI_API_KEY=votre_cle_gemini_ici

# Modèle par défaut ("auto" sélectionne automatiquement le modèle le plus rapide)
GEMINI_MODEL=auto

# Identité de l'assistant
ASSISTANT_NAME=MEL-IA
OWNER_NAME=Mel

# Port d'écoute (injecté automatiquement par Render, Railway, Fly.io, Heroku)
PORT=8000

# Base de données PostgreSQL optionnelle (Neon, Render Postgres, Supabase, Railway)
# Si non renseigné, MEL-IA utilise automatiquement SQLite local persistant (data/mel_ia.db)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

