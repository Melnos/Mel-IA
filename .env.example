# MEL-IA - Configuration d'environnement (optionnelle)
# NOTE : Aucune clé API par défaut n'est requise ici !
# Chaque utilisateur saisit sa propre clé API Gemini lors de la connexion ou de l'inscription.

# Modèle par défaut ("auto" sélectionne automatiquement les meilleurs modèles disponibles)
GEMINI_MODEL=auto

# Identité de l'assistant
ASSISTANT_NAME=MEL-IA
OWNER_NAME=

# Port d'écoute (défini automatiquement par Render, Railway ou Fly.io)
PORT=8000
