# Clé API Google Gemini (gratuite sur https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# Clés de secours optionnelles séparées par des virgules pour la rotation automatique
# GEMINI_API_KEYS=clé1,clé2,clé3

# Modèle par défaut ("auto" sélectionne automatiquement les meilleurs modèles disponibles)
GEMINI_MODEL=auto

# Identité de l'assistant
ASSISTANT_NAME=MEL-IA
OWNER_NAME=

# Port d'écoute (défini automatiquement par Render, Railway ou Fly.io)
PORT=8000
