# MEL-IA - Configuration d'environnement (optionnelle)
# NOTE : Aucune clé API par défaut n'est requise ici !
# Chaque utilisateur saisit sa propre clé API Gemini lors de la connexion ou de l'inscription.

# Modèle par défaut ("auto" sélectionne automatiquement les meilleurs modèles disponibles)
GEMINI_MODEL=auto

# Identité de l'assistant
ASSISTANT_NAME=MEL-IA
OWNER_NAME=

# Port d'écoute (défini automatiquement par Render, Railway ou Fly.io)
PORT=8000

# Base de données PostgreSQL Neon (serverless)
# Si cette variable est définie, l'application utilise automatiquement Neon pour
# les comptes utilisateurs, les discussions, les sessions et la mémoire.
# Sinon, l'application utilise SQLite en local (data/mel_ia.db).
# Exemple Neon : postgresql://neondb_owner:npg_xxxx@ep-cool-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
